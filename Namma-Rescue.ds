				values = {"Waterlogging","Shelter Request","Stranded Person","Drinking Water Request","Fallen Tree","Medical Evacuation","Power Hazard","Boat Rescue Request","Missing Person Check","Flooded Road"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Assigned","New","Verified","En Route","Resolved","Cancelled","On Scene"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Response_Sector
			(
				type = picklist	
				displayname = "Response Sector"
				values  = Sector_Reference.ID
