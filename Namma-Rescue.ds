	reports
	{
		list Incidents_Report
		{
			displayName = "All Incidents"
			show all rows from Incidents    
			(
				Incident_ID as "Incident ID"
				Reported_At as "Reported At"
				Incident_Type as "Incident Type"
				Severity
				Status
				Response_Sector as "Response Sector"
				Locality
				Nearby_Landmark as "Nearby Landmark"
				Location_Description as "Location Description"
				Latitude1 as "Latitude"
				Longitude1 as "Longitude"
				People_Affected as "People Affected"
				People_Trapped as "People Trapped"
				Medical_Assistance_Needed as "Medical Assistance Needed"
				Water_Depth_cm as "Water Depth cm"
				Water_Level_cm as "Water Level cm"
				Rainfall_1H_mm as "Rainfall 1H mm"
				Rainfall_24H_mm as "Rainfall 24H mm"
				Flood_Risk_Score as "Flood Risk Score"
				Flood_Risk_Level as "Flood Risk Level"
				Drainage_Status as "Drainage Status"
				Water_Level_Trend as "Water Level Trend"
				Safe_Crossing_Available as "Safe Crossing Available"
				Access_Status as "Access Status"
				Assigned_Team_ID as "Assigned Team ID"
				Assigned_Team_Name as "Assigned Team Name"
				ETA_Minutes as "ETA Minutes"
				Report_Channel as "Report Channel"
				Verified
				Last_Updated_At as "Last Updated At"
				Response_Notes as "Response Notes"
				Map_Link as "Map Link"
				Demo_Flag as "Demo Flag"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (Drainage_Status == "Blocked")
				fields = [Drainage_Status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (Drainage_Status == "Clear")
				fields = [Drainage_Status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (Drainage_Status == "Overflowing")
				fields = [Drainage_Status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (Drainage_Status == "Partially Clear")
				fields = [Drainage_Status]
				format = "color:#ffffff;background-color:#3598db;"
				}
				"New Formatting5"
				{
				condition = (Drainage_Status == "Unknown")
				fields = [Drainage_Status]
				format = "color:#ffffff;background-color:#bd588b;"
				}
			)
		}
		kanban Incidents_by_Drainage_Status
		{
			displayName = "Drainage Statuses"
			show all rows from Incidents    
			(
				Incident_ID as "Incident ID"
				Reported_At as "Reported At"
				Incident_Type as "Incident Type"
				Severity
				Status
				Response_Sector as "Response Sector"
				Locality
				Nearby_Landmark as "Nearby Landmark"
