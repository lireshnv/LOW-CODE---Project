 application "Namma-Rescue"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Calcutta"
 	time format = "24-hr"

 	forms
	{
		form Alerts_Log
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Alert_ID
			(
    			type = text
				displayname = "Alert ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Alert_Time
			(
    			type = datetime
				displayname = "Alert Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Alert_Type
			(
				type = picklist
				displayname = "Alert Type"
				values = {"Rescue Dispatch Update","Resource Stock Alert","Shelter Capacity Update","Road Access Advisory","Public Safety Notice","Water-Level Threshold","Heavy Rain Watch"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Response_Sector
			(
				type = picklist	
				displayname = "Response Sector"
				values  = Sector_Reference.ID
    			displayformat = [Response_Sector]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Target_Locality
			(
				type = picklist
				displayname = "Target Locality"
				values = {"Mudichur","Guindy","Adyar","T Nagar","Chromepet","Thiruvottiyur","Washermanpet","Egmore","Porur","Manali","Nungambakkam","Tambaram","Thirumullaivoyal","Mylapore","Ambattur","Puzhal","Kodungaiyur","Anna Nagar","Sholinganallur","Perungudi","Pallikaranai","Thoraipakkam","Perambur","Royapuram","Kotturpuram"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Message
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivery_Channel
			(
				type = picklist
				displayname = "Delivery Channel"
				values = {"Control Room Feed (demo)","Dashboard Banner","SMS Gateway (not connected)","Push Notification (not connected)"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Delivery_Status
			(
				type = picklist
				displayname = "Delivery Status"
				values = {"Draft","Acknowledged (demo)","Failed (demo)","Queued (demo)","Sent (demo)"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Acknowledged_Count
			(
				type = number
				displayname = "Acknowledged Count"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_Recipients
			(
				type = number
				displayname = "Estimated Recipients"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Demo_Flag
			(
    			type = checkbox
				displayname = "Demo Flag"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Incidents
		{
			success message = "Incidents Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Incident_ID
			(
    			type = text
				displayname = "Incident ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_At
			(
    			type = datetime
				displayname = "Reported At"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Incident_Type
			(
				type = picklist
